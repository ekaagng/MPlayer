        btnAbCompare.classList.remove('bg-secondary', 'text-on-tertiary');
        btnAbCompare.classList.add('bg-primary', 'text-primary-container');
      }
    });

    // Preset selector changes
    presetSelector.addEventListener('change', (e) => {
      const p = e.target.value;
      if (p === 'flat') {
        sliders.forEach(s => {
          s.value = 0;
          const display = s.closest('.group').querySelector('.eq-val');
          display.textContent = '0.0';
          display.className = 'eq-val text-[11px] font-headline font-bold text-on-surface-variant mb-2';
