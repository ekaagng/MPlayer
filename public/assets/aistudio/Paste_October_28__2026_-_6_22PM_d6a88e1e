    if (btnRefresh) {
      btnRefresh.addEventListener('click', () => {
        btnRefresh.classList.add('opacity-50');
        refreshTime.textContent = 'Enumerating...';
        setTimeout(() => {
          btnRefresh.classList.remove('opacity-50');
          refreshTime.textContent = 'Polled: just now';
          showToast('Hardware Refreshed', 'Enumerated 3 endpoints via IAudioEndpointVolume');
        }, 400);
      });
    }

    if (fallbackToggle && fallbackStatus) {
      fallbackToggle.addEventListener('change', (e) => {
        if (e.target.checked) {
          fallbackStatus.textContent = 'ACTIVE';
          fallbackStatus.className = 'font-mono text-[11px] font-bold text-on-surface uppercase';
        } else {
          fallbackStatus.textContent = 'STRICT DISALLOW';
          fallbackStatus.className = 'font-mono text-[11px] font-bold text-secondary uppercase';
        }
      });
    }

    if (btnRunSpike) {
      btnRunSpike.addEventListener('click', () => {
        btnRunSpike.disabled = true;
        testPatternState.textContent = 'INJECTING BURST...';
        progressBar.style.width = '20%';
        setTimeout(() => { progressBar.style.width = '65%'; }, 300);
        setTimeout(() => {
          progressBar.style.width = '100%';
          testPatternState.textContent = 'BIT-PERFECT CONFIRMED';
          btnRunSpike.disabled = false;
          showToast('Spike Verification Passed', 'Zero driver drift: 100% Bit-Perfect passthrough');
          setTimeout(() => { progressBar.style.width = '0%'; }, 2000);
        }, 800);
      });
    }

    if (btnExportLog) {
      btnExportLog.addEventListener('click', () => {
        const logContent = [
          '====================================================',
          'RESONANCE CORE - AUDIO ENGINE DIAGNOSTIC REPORT',
          '====================================================',
          `Generated: ${new Date().toISOString()}`,
          'OS Engine: Microsoft Windows WASAPI (Exclusive)',
          'Endpoint: Topping D90 III Sabre DAC [WASAPI Exclusive]',
          'Buffer Config: 128 samples / 2.6ms',
          'Buffer Under-runs: 0',
          'Software Volume Lock: 0.00 dB (100% Bit-Locked)',
          'Mixer Bypass: Active (IAudioClient3)',
          'DSP Pipe: All Filters Bypassed (1:1)',
          'Format Matrix: 24-bit/96kHz FLAC -> 32-bit float -> 24-bit WASAPI -> Native DAC',
          'Verification Spike Result: SUCCESS (0 bit errors)',
