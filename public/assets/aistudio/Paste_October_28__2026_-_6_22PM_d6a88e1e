    const dspToggle = document.getElementById('dsp-toggle');
    const btnReset = document.getElementById('btn-reset');
    const btnAbCompare = document.getElementById('btn-ab-compare');
    const abLabel = document.getElementById('ab-label');
    const presetSelector = document.getElementById('preset-selector');
    const sliders = document.querySelectorAll('.eq-band-slider');
    let isBState = false;

    // Preamp change listener
    preampSlider.addEventListener('input', (e) => {
      const val = parseFloat(e.target.value);
      preampVal.textContent = (val > 0 ? '+' : '') + val.toFixed(1) + ' dB';
    });

    // Slider updates
    sliders.forEach(slider => {
      slider.addEventListener('input', (e) => {
        const val = parseFloat(e.target.value);
        const card = e.target.closest('.group');
        const display = card.querySelector('.eq-val');
        
        display.textContent = (val > 0 ? '+' : '') + val.toFixed(1);
        if (val > 0) {
          display.className = 'eq-val text-[11px] font-headline font-bold text-primary mb-2';
        } else if (val < 0) {
          display.className = 'eq-val text-[11px] font-headline font-bold text-secondary mb-2';
        } else {
          display.className = 'eq-val text-[11px] font-headline font-bold text-on-surface-variant mb-2';
        }
      });
    });

    // Reset to Flat
    btnReset.addEventListener('click', () => {
      sliders.forEach(slider => {
        slider.value = 0;
        const card = slider.closest('.group');
        const display = card.querySelector('.eq-val');
        display.textContent = '0.0';
        display.className = 'eq-val text-[11px] font-headline font-bold text-on-surface-variant mb-2';
      });
      presetSelector.value = 'flat';
    });

    // A/B Compare Toggle
    btnAbCompare.addEventListener('click', () => {
      isBState = !isBState;
      if (isBState) {
        abLabel.textContent = 'A/B Compare [B: BYPASS]';
        btnAbCompare.classList.remove('bg-primary', 'text-primary-container');
        btnAbCompare.classList.add('bg-secondary', 'text-on-tertiary');
