{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MPlayer",
  "version": "0.1.0",
  "identifier": "com.ekaagung.mplayer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MPlayer",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
